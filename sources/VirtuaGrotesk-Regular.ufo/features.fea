sub yehBarree-ar by yehBarree-ar.fina;
sub lam_alef-ar by lam_alef-ar.fina;
sub lam_alefHamzaabove-ar by lam_alefHamzaabove-ar.fina;
sub lam_alefHamzabelow-ar by lam_alefHamzabelow-ar.fina;
sub lam_alefMadda-ar by lam_alefMadda-ar.fina;
sub lam_alefWasla-ar by lam_alefWasla-ar.fina;
} fina;

feature rlig {
# automatic
script arab;
lookup rlig_arab_0 {
	lookupflag IgnoreMarks;
	sub lam-ar.init alef-ar.fina by lam_alef-ar;
	sub lam-ar.medi alef-ar.fina by lam_alef-ar.fina;
	sub lam-ar.init alefHamzaabove-ar.fina by lam_alefHamzaabove-ar;
	sub lam-ar.medi alefHamzaabove-ar.fina by lam_alefHamzaabove-ar.fina;
	sub lam-ar.init alefHamzabelow-ar.fina by lam_alefHamzabelow-ar;
	sub lam-ar.medi alefHamzabelow-ar.fina by lam_alefHamzabelow-ar.fina;
	sub lam-ar.init alefMadda-ar.fina by lam_alefMadda-ar;
	sub lam-ar.medi alefMadda-ar.fina by lam_alefMadda-ar.fina;
	sub lam-ar.init alefWasla-ar.fina by lam_alefWasla-ar;
	sub lam-ar.medi alefWasla-ar.fina by lam_alefWasla-ar.fina;
} rlig_arab_0;
} rlig;

# --- Arabic: centred vs offset dots -----------------------------------------
#
# The dot sits under the tooth by default: the position that never collides,
# and what you get with calt off. It moves to the middle only when the next
# letter leaves the space clear.
#
# The first version had this the other way round — centre unless the next
# letter was on a short list — so centred was effectively the default and the
# dot ran into every descender that was not on it.

# Centring is the special case, not the default. The dot moves to the middle
# only before alef, where beh's tooth and alef's stem read as one bowl and a
# dot under the tooth looks pushed to the edge of it.
#
# This was a list of 70 letters — everything that did not descend — which made
# centred the normal look and the offset the exception. That is backwards.
# Add letters here one at a time, when a word shows it is wanted.
@AR_CLEAR_BELOW_NEXT = [
    alef-ar.fina alefHamzaabove-ar.fina alefHamzabelow-ar.fina
    alefMadda-ar.fina alefWasla-ar.fina
];

# The reverse case: the letter *before* reaches under the one that follows.
# reh and zain do not join to the left, so what comes after them is an initial
# form, and their tail sweeps back under its right-hand side — exactly where
# yeh's offset dots sit. Centring moves the dots out from under the tail.
@AR_TAIL_BELOW_PREV = [
    reh-ar reh-ar.fina zain-ar zain-ar.fina
    jeh-ar jeh-ar.fina rreh-ar rreh-ar.fina
];

feature calt {
script arab;
language dflt;
lookup calt_arab_dots {
	# beh: one dot.
	sub beh-ar.init' @AR_CLEAR_BELOW_NEXT by beh-ar.init.ctr;

	# yeh: two dots, 416 units of them against beh's 160. They reach much
	# further into whatever follows, so this class will probably want to be
	# narrower than beh's rather than the same one.
	sub yeh-ar.init' @AR_CLEAR_BELOW_NEXT by yeh-ar.init.ctr;
	sub @AR_TAIL_BELOW_PREV yeh-ar.init' by yeh-ar.init.ctr;
} calt_arab_dots;
} calt;

# Latin standard ligatures; intervening marks prevent replacement.
feature liga {
	lookup LATIN_F_LIGATURES {
		lookupflag 0;
		sub f i by fi;
		sub f l by fl;
	} LATIN_F_LIGATURES;
	script DFLT;
	language dflt;
	lookup LATIN_F_LIGATURES;
	script latn;
	language dflt;
	lookup LATIN_F_LIGATURES;
} liga;

# Short bars on narrow letters prevent collisions with following text.
@LATIN_NARROW_OVERLAY_BASES = [I Iacute Ibreve Icircumflex Idieresis Idotaccent Igrave Imacron Iogonek Itilde dotlessiogonek f fi fl florin i iacute ibreve icircumflex idieresis idotless igrave ij imacron iogonek itilde j jcircumflex jdotless l lacute lcaron lcommaaccent ldot longs r racute rcaron rcedilla t tbar tcaron tcedilla tcommaaccent];
feature ccmp {
	lookup LATIN_NARROW_OVERLAY {
		lookupflag UseMarkFilteringSet [strokeshortcomb strokeshortcomb.narrow slashshortcomb slashshortcomb.narrow slashlongcomb slashlongcomb.narrow];
		sub @LATIN_NARROW_OVERLAY_BASES strokeshortcomb' by strokeshortcomb.narrow;
		sub @LATIN_NARROW_OVERLAY_BASES slashshortcomb' by slashshortcomb.narrow;
		sub @LATIN_NARROW_OVERLAY_BASES slashlongcomb' by slashlongcomb.narrow;
	} LATIN_NARROW_OVERLAY;
} ccmp;

# Short-stroke overlay: body centers, independent of top/bottom accents.
markClass [strokeshortcomb strokeshortcomb.narrow slashshortcomb slashshortcomb.narrow slashlongcomb slashlongcomb.narrow] <anchor 0 0> @LATIN_STROKE_OVERLAY;
