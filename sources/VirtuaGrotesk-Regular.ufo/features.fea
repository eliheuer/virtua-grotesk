	lookup LATIN_STROKE_LIGATURES {
		lookupflag UseMarkFilteringSet [strokeshortcomb strokeshortcomb.narrow slashshortcomb slashshortcomb.narrow slashlongcomb slashlongcomb.narrow];
		pos ligature fi <anchor (wght=400:184 wght=700:216) 288> mark @LATIN_STROKE_OVERLAY ligComponent <anchor (wght=400:408 wght=700:488) 288> mark @LATIN_STROKE_OVERLAY;
		pos ligature fl <anchor (wght=400:184 wght=700:216) 288> mark @LATIN_STROKE_OVERLAY ligComponent <anchor (wght=400:448 wght=700:536) 288> mark @LATIN_STROKE_OVERLAY;
	} LATIN_STROKE_LIGATURES;
