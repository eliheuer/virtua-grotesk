# Long-solidus negation on existing mathematical bases; no outline changes.
markClass slashlongcomb <anchor 0 0> @MATH_LONG_SOLIDUS;
feature mark {
	lookup MATH_LONG_SOLIDUS_BASES {
		lookupflag UseMarkFilteringSet [slashlongcomb];
		pos base equal <anchor 304 352> mark @MATH_LONG_SOLIDUS;
		pos base less <anchor 304 352> mark @MATH_LONG_SOLIDUS;
		pos base greater <anchor 304 352> mark @MATH_LONG_SOLIDUS;
		pos base plus <anchor 304 352> mark @MATH_LONG_SOLIDUS;
		pos base minus <anchor 304 304> mark @MATH_LONG_SOLIDUS;
		pos base lessequal <anchor 304 368> mark @MATH_LONG_SOLIDUS;
		pos base greaterequal <anchor 304 368> mark @MATH_LONG_SOLIDUS;
	} MATH_LONG_SOLIDUS_BASES;
} mark;
